    "web/src/knob-migrate.ts",
    "web/src/pages.ts",
    "web/src/storage-key.ts",
    "web/src/structure.ts",
    "web/scripts/lineage-lib.ts",
    "web/scripts/preset-migration-c.ts",
    "web/src/preset-lineage.json",
    "web/src/preset-maps.ts",
    "web/src/preset-migrate.ts",
    "web/src/preset-migrations.json",
    ".github/workflows/web.yml",
    ".github/workflows/release.yml"
  ],
  "host_commands": {
    "golden": ["tools/golden.sh"],
    "aot": ["tools/aot_test.sh"],
    "usb": ["tools/usb_test.sh"],
    "clock": ["tools/clock_out_test.sh"],
    "peak": ["tools/peak_test.sh"],
    "audio": ["tools/audio_out_test.sh"],
    "frame": ["tools/frame_test.sh"],
    "ota": ["tools/ota_test.sh"],
    "guard": ["tools/guard_test.sh"],
    "power": ["tools/power_test.sh"],
    "installer": ["python3", "tools/fm1_install_test.py"],
    "panel": ["tools/panel_test.sh"],
    "preset": ["tools/preset_test.sh"],
    "bank": ["tools/bank_new_test.sh"],
    "ui": ["tools/ui_preview.sh", "build/ui-preview.png", "0", "1"],
    "selector": ["python3", "tools/ci_checks_test.py"],
    "usb_return": ["sh", "tools/usb_return_test.sh"],
    "coverage-record": ["python3", "tools/coverage_record_test.py"],
    "release-build": ["python3", "tools/build_test.py"]
  },
  "full_host": ["golden", "aot", "usb", "usb_return", "clock", "peak", "audio", "frame", "ota", "guard", "power", "installer", "panel", "preset", "bank", "ui"],
  "optional_host": {"usb_return": "firmware/src/usb_return.h"},
  "rules": [
    {"name": "Release artifact preparation", "paths": ["tools/build.py", "tools/build_test.py", "tools/release_manifest.py", ".github/workflows/release.yml"], "host": ["release-build"], "web": []},
    {"name": "CI selection and workflows", "paths": ["tools/ci_checks*", "tools/ci_test_plan.json", ".github/workflows/firmware.yml", ".github/workflows/web.yml", ".github/workflows/release.yml"], "host": ["selector"], "web": []},
    {"name": "USB and audio transport", "paths": ["firmware/src/usb.c", "firmware/src/audio.c", "firmware/src/midi_queue.h", "firmware/hal/*usb*", "firmware/hal/*audio*"], "host": ["usb", "audio", "peak", "usb_return"], "web": ["web/src/audio.test.ts"]},
    {"name": "MIDI and clock", "paths": ["firmware/src/clock_out.h", "firmware/src/midi_input.h", "firmware/src/midi_uart.c", "firmware/src/tempo_glo.h", "web/src/arpeggiator.ts", "web/src/harmonizer.ts", "web/src/track.ts", "web/src/locks.ts", "web/src/arm.ts"], "host": ["clock", "golden"], "web": ["web/src/clock-out.test.ts", "web/src/arpeggiator.test.ts", "web/src/harmonizer.test.ts"]},
    {"name": "Protocol and main loop", "paths": ["firmware/src/proto.c", "firmware/src/main.c", "firmware/src/host_frame.h", "web/src/protocol.ts"], "host": ["golden", "frame", "preset"], "web": ["web/src/protocol.test.ts"]},
    {"name": "Patch storage and migration", "paths": ["firmware/src/preset*", "firmware/src/slotstore.c", "firmware/src/storage_hw.c", "firmware/src/bank_new.h", "web/src/preset-*", "web/scripts/preset-migration-c.ts", "web/scripts/lineage-lib.ts", "web/scripts/legacy-factory*", "web/scripts/released-factory.json"], "host": ["preset", "bank"], "web": ["web/src/preset-migrate.test.ts", "web/src/legacy-factory.test.ts"]},
    {"name": "Panel and screen", "paths": ["firmware/src/*ui.c", "firmware/src/panel.c", "firmware/src/menu.c", "firmware/src/manual.c", "firmware/src/lcd*", "firmware/src/screen_text.h", "firmware/src/help*", "firmware/src/poly_edit.h", "firmware/src/sandbox*", "firmware/wasm/*", "web/src/controls.ts", "web/scripts/controls-h.ts", "web/src/pages.ts", "web/src/buttons.ts", "web/src/labels.ts", "web/src/device-shown.ts"], "host": ["panel", "ui"], "web": ["web/src/fm1-ui.test.ts", "web/src/piano.test.ts", "web/src/roll.test.ts"]},
    {"name": "Engine and patch format", "paths": ["firmware/src/engine*", "firmware/src/rate_envelope.h", "firmware/src/defs.h", "firmware/src/dsp_tables.h", "firmware/src/wt_tables.h", "web/src/engine.ts", "web/src/modules.ts", "web/src/patch.ts", "web/src/patchbin.ts", "web/src/poly.ts", "web/src/rate-envelope.ts", "web/src/parameter-routing.ts", "web/src/wavetables.json", "web/src/test-patches.ts", "web/src/test-poly.ts", "web/src/fallback.ts", "web/src/structure.ts", "web/src/device-compile.ts", "web/scripts/golden.ts", "web/scripts/export-defs.ts", "tools/gen_dsp_tables.py", "tools/gen_wavetables.py"], "host": ["golden", "aot"], "web": ["web/src/engine.test.ts", "web/src/patchbin.test.ts", "web/src/voice-extremes.test.ts"]},
    {"name": "Ahead-of-time engine", "paths": ["firmware/src/aot*", "web/scripts/gen-aot.ts", "web/scripts/aot-kits.ts"], "host": ["aot", "golden"], "web": []},
    {"name": "Factory and CPU model", "paths": ["web/presets/**", "web/src/assemblies*", "web/src/assemblies/**", "web/src/assembly.ts", "web/src/presets.ts", "web/src/cpu*", "web/src/engines.ts", "web/src/factory-presets.ts", "web/src/device-presets.ts", "web/src/knob-migrate.ts", "web/src/storage-key.ts", "firmware/src/presets.h", "firmware/src/controls.h", "web/scripts/gen-presets.ts", "web/scripts/gen-assemblies.ts"], "host": ["preset", "golden"], "web": ["web/src/factory-presets.test.ts", "web/src/cpu.test.ts", "web/src/assembly.test.ts"]},
    {"name": "Update and installer", "paths": ["firmware/src/ota*", "tools/fm1_install*", "tools/fm1pkg_make.py", "web/public/firmware/*", "web/src/flasher/**", "web/dev/branch-firmware.ts", "web/scripts/branch-firmware.mjs", "web/scripts/flash.mjs", "web/scripts/sync-firmware.mjs"], "host": ["ota", "installer"], "web": ["web/src/flasher.test.ts", "web/src/upload-gate.test.ts"]},
    {"name": "Overload accounting", "paths": ["firmware/src/ovl_guard.h", "firmware/src/blk_time.h", "firmware/src/bench.c"], "host": ["guard", "peak"], "web": []},
    {"name": "Supply setup", "paths": ["firmware/hal/fm1_power.h"], "host": ["power"], "web": []},
    {"name": "Build and dependencies", "paths": ["tools/build.py", "tools/get_toolchain.sh", "firmware/app.ld", "firmware/src/modular.c", "firmware/test/host_ui.h", "web/package.json", "web/package-lock.json", "web/vite.config.ts", "web/tsconfig*.json"], "host": ["installer"], "web": ["web/src/version.test.ts", "web/src/engine-start.test.ts", "web/src/flasher.test.ts"]},
    {"name": "UI entry and CSS", "paths": ["web/src/main.ts", "web/src/*.css", "web/index.html"], "host": [], "web": ["web/src/startup.test.ts", "web/src/commands.test.ts", "web/src/editor-focus.test.ts"]},
    {"name": "Share API", "paths": ["web/functions/**"], "host": [], "web": ["web/src/share-store.test.ts"]},
    {"name": "Host test golden", "paths": ["tools/golden.sh", "firmware/test/host_test.c", "firmware/test/proto_test.c", "firmware/test/idle_test.c"], "host": ["golden"], "web": []},
    {"name": "Host test aot", "paths": ["tools/aot_test.sh", "firmware/test/aot_test.c"], "host": ["aot"], "web": []},
    {"name": "Host test usb", "paths": ["tools/usb_test.sh", "firmware/test/usb_test.c"], "host": ["usb"], "web": []},
    {"name": "Host test clock", "paths": ["tools/clock_out_test.sh", "firmware/test/clock_out_test.c"], "host": ["clock"], "web": []},
    {"name": "Host test peak", "paths": ["tools/peak_test.sh", "firmware/test/peak_test.c"], "host": ["peak"], "web": []},
    {"name": "Host test audio", "paths": ["tools/audio_out_test.sh", "firmware/test/audio_out_test.c"], "host": ["audio"], "web": []},
    {"name": "Host test frame", "paths": ["tools/frame_test.sh", "firmware/test/frame_test.c"], "host": ["frame"], "web": []},
    {"name": "Host test ota", "paths": ["tools/ota_test.sh", "firmware/test/ota_test.c"], "host": ["ota"], "web": []},
    {"name": "Host test guard", "paths": ["tools/guard_test.sh", "firmware/test/guard_test.c"], "host": ["guard"], "web": []},
    {"name": "Host test power", "paths": ["tools/power_test.sh", "firmware/test/power_test.c"], "host": ["power"], "web": []},
    {"name": "Host test installer", "paths": ["tools/fm1_install_test.py"], "host": ["installer"], "web": []},
    {"name": "Host test panel", "paths": ["tools/panel_test.sh", "firmware/test/panel_test.c"], "host": ["panel"], "web": []},
    {"name": "Host test preset", "paths": ["tools/preset_test.sh", "firmware/test/preset_test.c"], "host": ["preset"], "web": []},
    {"name": "Host test bank", "paths": ["tools/bank_new_test.sh", "firmware/test/bank_new_test.c"], "host": ["bank"], "web": []},
    {"name": "Host test ui", "paths": ["tools/ui_preview.sh", "firmware/test/ui_preview.c"], "host": ["ui"], "web": []},
    {"name": "Panel fixtures", "paths": ["firmware/test/*test.h", "firmware/test/midi_redraw_test.c", "firmware/test/lanes_host.h"], "host": ["panel"], "web": []},
    {"name": "Ledger checks handled by the required ledger job", "paths": ["tools/ledger_check*", ".github/workflows/ledger-check.yml"], "host": [], "web": []},
    {"name": "USB return, identity and persistent settings", "paths": ["firmware/src/usb_return.h", "firmware/src/usb_poll_clock.h", "firmware/src/device_identity.h", "firmware/src/device_settings.c", "firmware/test/usb_return_test.c", "firmware/test/usb_poll_clock_test.c", "firmware/test/device_identity_test.c", "tools/usb_return_test.sh"], "host": ["usb_return", "usb", "panel"], "web": []},
    {"name": "Flash storage hardware", "paths": ["firmware/hal/fm1_flash.h"], "host": ["preset", "bank"], "web": []},
    {"name": "Editor rendering and FM-1 mirror", "paths": ["web/src/editor.ts", "web/src/fm1-view.ts"], "host": [], "web": ["web/src/panel-align.test.ts", "web/src/factory-reconciled.test.ts", "web/src/emu-keys.test.ts"]},
    {"name": "Piano step-grid editing", "paths": ["web/src/step-grid.ts"], "host": [], "web": ["web/src/step-grid-entry.test.ts", "web/src/step-grid-locks.test.ts"]},
    {"name": "Scenario fixtures and runner helpers", "paths": ["web/scripts/device-check.mjs", "web/scripts/emu-scenarios.mjs", "web/scripts/rig-link.mjs", "web/dev/rig-client.ts"], "host": [], "web": ["web/src/check-fixtures.test.ts", "web/scripts/emu-channel.test.mjs", "web/scripts/emu-process.test.mjs", "web/scripts/rig-link.test.mjs", "web/src/device.test.ts", "web/src/input.test.ts"]},
    {"name": "Coverage display preparation", "paths": ["tools/coverage_record*", "web/src/coverage.ts", "web/src/about.ts", "web/scripts/coverage-stats.ts", ".github/workflows/pages.yml", "release/coverage/**"], "host": ["coverage-record"], "web": ["web/src/coverage.test.ts"]},
    {"name": "Emulator smoke fixture review", "paths": ["tools/emu/src/main.rs", "tools/emu/src/smoke.rs"], "host": [], "web": [], "manual": "Requires reviewed focused fixture evidence for these exact harness bytes in tools/ci_test_plan.json; full emulator qualification is reserved for the frozen release candidate."},
    {"name": "Native USB audio capture", "paths": ["tools/fm1_rec.swift"], "host": [], "web": [], "manual": "Requires a focused recorder test plan: native capture behavior has no CI regression runner. Add a reviewed plan for these exact changed bytes in tools/ci_test_plan.json."}
  ],
  "non_runtime": ["release/coverage/**", "docs/**", "*.md", "LICENSE*", "LICENSES/**", ".gitignore", ".gitattributes", ".github/ISSUE_TEMPLATE/**", ".github/PULL_REQUEST_TEMPLATE*", "web/public/brand/**", "web/public/*.png", "web/public/*.svg", "web/public/*.ico", "web/public/*.txt", "web/public/ai-stats.json", "web/public/coverage.json"]
 }
