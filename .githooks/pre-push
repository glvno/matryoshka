#!/bin/sh
# Stores this clone's Claude Code + Codex prompt count as the repo's Actions variable AI_PROMPTS_<clone id> before the push, so the
# Pages build the push starts shows it on the About card (web/src/ai-prompts.ts). Never blocks the push.
# Enable once per clone: git config core.hooksPath .githooks
web="$(git rev-parse --show-toplevel)/web"
[ -f "$web/scripts/ai-prompts.ts" ] && [ -d "$web/node_modules" ] || exit 0
command -v gh >/dev/null 2>&1 || exit 0
(cd "$web" && npm run -s ai-prompts -- push) >&2 || true
exit 0
